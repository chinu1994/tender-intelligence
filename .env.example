# Copy to .env and replace every "replace-..." value. Never commit .env.

# --- Application -----------------------------------------------------------
APP_NAME=Tender Intelligence
# development | staging | production  (staging/production hide reset tokens
# in API responses and enforce stricter configuration checks)
APP_ENV=development
CORS_ORIGINS=http://localhost:3000
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- PostgreSQL + pgvector -------------------------------------------------
POSTGRES_DB=tender_intelligence
POSTGRES_USER=tender_user
POSTGRES_PASSWORD=replace-with-a-strong-local-password
# Host port published by docker-compose.override.yml (development only)
POSTGRES_EXPOSED_PORT=5436
# Database-level tenant isolation (PostgreSQL row-level security)
RLS_ENABLED=true

# --- Redis / background workers ---------------------------------------------
REDIS_EXPOSED_PORT=6379
WORKER_CONCURRENCY=2
# Process inline if the broker is unreachable (keeps demos working)
TASK_SYNC_FALLBACK=true

# --- Authentication -----------------------------------------------------------
# At least 32 random characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=3HYUy7RpVjAf5aaUAD8pMIrzmchFxDuRd7XVS4smwLpVRWr_RyZE0y0xHpE2TraZ
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# No mail server yet: return reset tokens in the API response (ignored in production)
EXPOSE_RESET_TOKEN=true

# --- Uploads -------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50

# --- AI providers (provider-agnostic; mock needs no keys) ---------------------
# LLM: mock | groq | openai_compatible
AI_PROVIDER=mock
# Embeddings: mock | openai_compatible   (model must return 384 dimensions)
EMBEDDING_PROVIDER=mock
# Vector retrieval: pgvector | mock
VECTOR_RETRIEVER=pgvector

# Any OpenAI-compatible endpoint (Ollama, vLLM, LocalAI, TEI, hosted APIs)
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_API_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Groq preset (only when AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
